# "fake" runs offline and deterministic. "claude" uses the Anthropic API.
DILIGENCE_LLM=fake
ANTHROPIC_API_KEY=
DILIGENCE_MODEL=claude-sonnet-5-5
DILIGENCE_MAX_REVISIONS=2
# Set to your model's current prices (USD per million tokens) for accurate cost tracking.
DILIGENCE_PRICE_INPUT_PER_M=3.0
DILIGENCE_PRICE_OUTPUT_PER_M=15.0
